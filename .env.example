# EvidenceGraph AI — environment variables (all optional).
#
# These are ordinary shell environment variables; the app does not require a .env file.
# To use a file, copy it to apps/web/.env.local (Next.js loads that one). Never commit real values.

# --- Where the wiki lives -------------------------------------------------------------
# Folder to use as the active wiki. Overrides the folder chosen in Settings → Wikis.
# (LLM_WIKI_PATH is the older name and is still honored; EVIDENCEGRAPH_PATH wins.)
# EVIDENCEGRAPH_PATH=/path/to/my-research-wiki

# Port used by the packaged CLI (`evidencegraph start`). `pnpm dev` always uses 3000.
# EVIDENCEGRAPH_PORT=3737

# Where the global config (recent wikis, key fallback) is stored. Mostly for tests.
# The folder name is kept from the upstream project so existing configs keep working.
# LLM_WIKI_CONFIG_DIR=~/.llm-wiki

# --- Model providers ------------------------------------------------------------------
# The OpenRouter key is normally entered in Settings → API and stored in your OS keychain.
# Do NOT put a real key in a file that could be committed.
#
# For a server with no OS keychain, set this in the process environment instead. When it is set,
# the app uses it, never stores it, and refuses to save or remove a key from Settings:
# EVIDENCEGRAPH_OPENROUTER_API_KEY=
#
# This different variable is read ONLY by `pnpm eval --live`:
# OPENROUTER_API_KEY=

# --- URL ingestion --------------------------------------------------------------------
# Private, loopback and link-local addresses are blocked by default. Set to 1 only if you run
# the app on your own machine and want to ingest pages from it or from your local network.
# EVIDENCEGRAPH_ALLOW_PRIVATE_URLS=1

# Base URL of a local Ollama server (default http://localhost:11434).
# `pnpm demo` points this at its built-in mock model.
# OLLAMA_BASE_URL=http://localhost:11434
